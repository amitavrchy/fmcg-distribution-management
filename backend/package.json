{
  "name": "@fmcg/backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev:all": "concurrently -n api,web -c cyan,green \"npm run dev\" \"npm --prefix ../frontend run dev\"",
    "build:all": "npm run build && npm --prefix ../frontend run build",
    "check:all": "npm run typecheck && npm --prefix ../frontend run typecheck",
    "test:e2e": "playwright test",
    "format": "prettier --write src test e2e ../frontend/src",
    "db:seed:advanced": "tsx prisma/seed-advanced.ts",
    "verify": "node scripts/verify.mjs",
    "verify:browser": "node scripts/verify.mjs --browser",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/platform-socket.io": "^12.3.3",
    "@nestjs/websockets": "^12.3.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
